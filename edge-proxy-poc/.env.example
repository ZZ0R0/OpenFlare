# OpenFlare Edge Proxy POC - Environment Variables
# Copy to .env and customize

# Admin API token (change in production!)
ADMIN_TOKEN=change-me

# Proxy configuration file
PROXY_CONFIG=configs/proxy.dev.yaml

# WAF rules file
WAF_RULES=configs/rules.waf.yaml

# Cache rules file
CACHE_RULES=configs/cache-rules.yaml

# Rate limit rules file
RATE_LIMIT_RULES=configs/rate-limit.yaml

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Testsite port
TESTSITE_PORT=8000

# Proxy public port
PROXY_PORT=8080

# Proxy admin port
PROXY_ADMIN_PORT=8081
